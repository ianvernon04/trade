__pycache__/
*.pyc
journal.db
autonomy.json
.venv/
venv/
autotrade.log
cron-stderr.log
.autotrade.lock/
preflight.status
launchd-stdout.log
launchd-stderr.log
server.log

# This repo is public, and these hold real account data — account numbers,
# balances, position sizes. settings.local.json in particular accumulates
# allowlisted command strings, and the commands this agent runs quote live
# positions back verbatim. A machine-level ignore covers it here but does
# not travel with a clone, so the rule belongs in the repo too.
.claude/settings.local.json
*.local.json
positions*.json
eqpos*.json
backup*.json

# Only Me & You keeps its whole world (SQLite DB + photos/voice/video) here.
# It is personal media belonging to two real people — never commit it.
onlymeyou/data/

# real broker exports never get committed
robinhood-activity.csv
*.activity.csv

# Journal backups are local state, like journal.db itself — they carry raw
# broker payloads (account numbers, balances) and this repo is public.
journal.db.bak-*
# Operational logs and one-off audit dumps: machine-local, not source.
watchdog.log
.audit-tmp/
